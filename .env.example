# Base URLs (override to point the suite at a different environment)
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# SauceDemo's own published test account — not a secret
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# LLM provider for the self-healing agent and the test-orchestrator agents.
# Leave ANTHROPIC_API_KEY unset to run entirely offline against the deterministic MockLlmProvider.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# LLM_PROVIDER=anthropic   # uncomment to force a provider instead of auto-selecting on key presence

# Set to false to disable the self-healing locator agent entirely
SELF_HEALING_ENABLED=true
